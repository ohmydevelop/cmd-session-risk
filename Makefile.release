# cmd-risk single-binary build
CC ?= cc
CFLAGS ?= -O3 -march=x86-64-v2
LDFLAGS ?= -lm
.PHONY: all objects binary smoke clean_dir

all: build/cmdrisk
objects: build/model_f32.o build/vocab.o

build/model_f32.o: ci_assets/model_f32.bin
	mkdir -p build
	ld -r -b binary ci_assets/model_f32.bin -o build/model_f32.o

build/vocab.o: ci_assets/vocab.txt
	mkdir -p build
	ld -r -b binary ci_assets/vocab.txt -o build/vocab.o

build/cmdrisk: tools/cmdrisk_single.c build/model_f32.o build/vocab.o
	mkdir -p build
	$(CC) $(CFLAGS) tools/cmdrisk_single.c build/model_f32.o build/vocab.o $(LDFLAGS) -o build/cmdrisk

smoke: build/cmdrisk
	./build/cmdrisk ci_assets/smoke_text.txt 0.0001179935351014905 > build/smoke.out 2> build/smoke.err
	test "$$(wc -l < build/smoke.out)" -eq 8
