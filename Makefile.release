# cmd-risk single-binary build
CC ?= cc
CFLAGS ?= -O3 -march=x86-64-v2
LDFLAGS ?= -lm
.PHONY: all objects binary smoke clean_dir

all: build/cmdrisk
objects: build/model_f32.o build/vocab.o build/calibration.o build/model_config.o

build/model_f32.o: ci_assets/model_f32.bin
	mkdir -p build
	ld -r -b binary ci_assets/model_f32.bin -o build/model_f32.o

build/vocab.o: ci_assets/vocab.txt
	mkdir -p build
	ld -r -b binary ci_assets/vocab.txt -o build/vocab.o

build/calibration.o: ci_assets/calibration.json
	mkdir -p build
	ld -r -b binary ci_assets/calibration.json -o build/calibration.o

build/model_config.o: ci_assets/model_config.json
	mkdir -p build
	ld -r -b binary ci_assets/model_config.json -o build/model_config.o

build/cmdrisk: tools/cmdrisk_single.c build/model_f32.o build/vocab.o build/calibration.o build/model_config.o
	mkdir -p build
	$(CC) $(CFLAGS) tools/cmdrisk_single.c build/model_f32.o build/vocab.o build/calibration.o build/model_config.o $(LDFLAGS) -o build/cmdrisk

smoke: build/cmdrisk
	./build/cmdrisk ci_assets/smoke_text.txt 0.00011 > build/smoke.out 2> build/smoke.err
	test "$$(wc -l < build/smoke.out)" -eq 8
	awk '$$4!=1{exit 1}' build/smoke.out
	./build/cmdrisk ci_assets/regression_borderline.txt 0.00011 > build/reg.out 2> build/reg.err
	test "$$(wc -l < build/reg.out)" -eq 21
	awk '$$4!=0{exit 1}' build/reg.out
	awk '$$5!=0{exit 1}' build/reg.out
	./build/cmdrisk ci_assets/regression_critical.txt 0.00011 > build/crit.out 2> build/crit.err
	test "$$(wc -l < build/crit.out)" -eq 28
	awk '$$4!=1{exit 1}' build/crit.out
	awk '$$5!=1{exit 1}' build/crit.out
